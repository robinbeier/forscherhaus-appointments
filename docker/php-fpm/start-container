#!/bin/bash
set -euo pipefail

echo "➜ Ignore Permission Changes"
# CI checkouts need not expose a writable Git directory inside the container.
# This is only a local Git display preference, not a startup requirement.
if ! git config --local core.fileMode false >/dev/null 2>&1; then
    echo "➜ Git file-mode preference unavailable"
fi

echo "➜ Set Correct Permissions"
if [[ -L storage || ! -d storage ]]; then
    echo "✖ Refusing invalid storage root: storage" >&2
    exit 1
fi
# Restrict the bind-mounted parent before classifying its children. PHP-FPM
# writes within the prepared runtime children and its separate session volume.
chmod 0755 storage
if [[ -L /var/www/html/.fh-login-kdf || ( -e /var/www/html/.fh-login-kdf && ! -d /var/www/html/.fh-login-kdf ) ]]; then
    echo "✖ Refusing invalid login KDF lock directory" >&2
    exit 1
fi
mkdir -p /var/www/html/.fh-login-kdf
if ! symlinked_storage_child="$(find -P storage -mindepth 1 -maxdepth 1 ! -name sessions -type l -print -quit)"; then
    echo "✖ Could not inspect storage children" >&2
    exit 1
fi
if [[ -n "$symlinked_storage_child" ]]; then
    echo "✖ Refusing symlinked storage child" >&2
    exit 1
fi
for runtime_dir in storage/{backups,cache,logs,uploads}; do
    if [[ -L "$runtime_dir" || ! -d "$runtime_dir" ]]; then
        echo "✖ Refusing invalid runtime directory: $runtime_dir" >&2
        exit 1
    fi
done
# Backups are written by the operator's CLI process and must not be writable by
# the web worker. Other runtime directories retain their existing permissions.
chmod 0700 storage/backups
chmod 0777 storage/{cache,logs,uploads}
chown root:root /var/www/html/.fh-login-kdf
chmod 0755 /var/www/html/.fh-login-kdf
for slot_file in /var/www/html/.fh-login-kdf/slot-{0..3}.lock; do
    if [[ -L "$slot_file" || -d "$slot_file" || ( -e "$slot_file" && ! -f "$slot_file" ) ]]; then
        echo "✖ Refusing invalid login KDF slot: $slot_file" >&2
        exit 1
    fi
    if [[ -e "$slot_file" && "$(stat -c '%h' "$slot_file")" != 1 ]]; then
        echo "✖ Refusing hardlinked login KDF slot: $slot_file" >&2
        exit 1
    fi
    touch "$slot_file"
    chown www-data:www-data "$slot_file"
    chmod 0600 "$slot_file"
    web_uid="$(id -u www-data)"
    web_gid="$(id -g www-data)"
    slot_stat="$(stat -c '%u:%g:%a:%h:%F' "$slot_file")"
    [[ "$slot_stat" == "${web_uid}:${web_gid}:600:1:regular empty file" || "$slot_stat" == "${web_uid}:${web_gid}:600:1:regular file" ]] || {
        echo "✖ Invalid login KDF slot metadata: $slot_file" >&2
        exit 1
    }
done

echo "➜ Prepare Private Session Volume"
if [[ -L storage/sessions ]] || ! mountpoint -q storage/sessions; then
    echo "✖ Refusing to prepare storage/sessions without a dedicated non-symlink mount." >&2
    exit 1
fi
chown www-data:www-data storage/sessions
chmod 700 storage/sessions

echo "➜ Ensure Local Config"
[[ -f config.php ]] || cp config-sample.php config.php

echo "➜ Install Composer Dependencies"
[[ -d vendor ]] || composer install

if [[ "${EA_SKIP_NPM_BOOTSTRAP:-0}" == "1" ]]; then
    echo "➜ Skip NPM Dependency Bootstrap"
else
    echo "➜ Verify Node.js minimum version"
    bash ./scripts/ci/require_node_minimum.sh 24.22.3 docker-bootstrap
    echo "➜ Install NPM Dependencies"
    [[ -d node_modules ]] || npm install
fi

if [[ "${EA_SKIP_ASSET_BUILD_BOOTSTRAP:-0}" == "1" ]]; then
    echo "➜ Skip Asset Build Bootstrap"
else
    echo "➜ Build Project Assets"
    [[ -d assets/vendor ]] || npx gulp compile
fi

echo "➜ Listen To Incoming Requests"
# Forward container stop signals directly to the PHP-FPM master.
exec php-fpm

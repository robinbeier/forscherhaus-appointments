#!/bin/bash
set -euo pipefail

echo "➜ Ignore Permission Changes"
# CI checkouts need not expose a writable Git directory inside the container.
# This is only a local Git display preference, not a startup requirement.
if ! git config --local core.fileMode false >/dev/null 2>&1; then
    echo "➜ Git file-mode preference unavailable"
fi

echo "➜ Set Correct Permissions"
if [[ -L storage || ! -d storage ]]; then
    echo "✖ Refusing invalid storage root: storage" >&2
    exit 1
fi
if ! symlinked_storage_child="$(find -P storage -mindepth 1 -maxdepth 1 ! -name sessions -type l -print -quit)"; then
    echo "✖ Could not inspect storage children" >&2
    exit 1
fi
if [[ -n "$symlinked_storage_child" ]]; then
    echo "✖ Refusing symlinked storage child" >&2
    exit 1
fi
chmod 777 storage
find -P storage -mindepth 1 -maxdepth 1 ! -name sessions ! -type l -exec chmod -R 777 -- {} +

echo "➜ Prepare Private Session Volume"
if [[ -L storage/sessions ]] || ! mountpoint -q storage/sessions; then
    echo "✖ Refusing to prepare storage/sessions without a dedicated non-symlink mount." >&2
    exit 1
fi
chown www-data:www-data storage/sessions
chmod 700 storage/sessions

echo "➜ Ensure Local Config"
[[ -f config.php ]] || cp config-sample.php config.php

echo "➜ Install Composer Dependencies"
[[ -d vendor ]] || composer install

if [[ "${EA_SKIP_NPM_BOOTSTRAP:-0}" == "1" ]]; then
    echo "➜ Skip NPM Dependency Bootstrap"
else
    echo "➜ Verify Node.js minimum version"
    bash ./scripts/ci/require_node_minimum.sh 24.0.0 docker-bootstrap
    echo "➜ Install NPM Dependencies"
    [[ -d node_modules ]] || npm install
fi

if [[ "${EA_SKIP_ASSET_BUILD_BOOTSTRAP:-0}" == "1" ]]; then
    echo "➜ Skip Asset Build Bootstrap"
else
    echo "➜ Build Project Assets"
    [[ -d assets/vendor ]] || npx gulp compile
fi

echo "➜ Listen To Incoming Requests"
# Forward container stop signals directly to the PHP-FPM master.
exec php-fpm

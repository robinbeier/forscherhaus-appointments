{
    "schema_version": 2,
    "publish": {
        "linear_state": "In Review",
        "may_set_ready_to_merge": false,
        "push_invalidates_exact_head_evidence": true
    },
    "land": {
        "requires_exact_head": true,
        "merge_command": "gh pr merge --merge --match-head-commit <current_head_sha>",
        "push_after_ready_linear_state": "In Review",
        "exact_head_mergegate": {
            "schema_version": 1,
            "base_ref": "main",
            "workflow_file": "ci.yml",
            "workflow_name": "CI",
            "pr_revalidation": "before_between_and_immediately_before_final_review_observation",
            "review_evidence_revalidation": "two_identical_bounded_observations",
            "review_lens_source": "review.sensitive_change_lenses",
            "required_checks": [
                "changes",
                "build-test",
                "js-lint-changed",
                "phpstan-application",
                "typed-request-dto",
                "architecture-ownership-map",
                "architecture-boundaries"
            ],
            "conditional_checks": [
                "typed-request-contracts",
                "deep-check-bootstrap",
                "deep-check-seed-snapshot",
                "deep-runtime-suite",
                "coverage-shard-unit",
                "coverage-shard-integration",
                "coverage-delta",
                "api-contract-openapi",
                "write-contract-booking",
                "write-contract-api",
                "booking-controller-flows",
                "integration-smoke"
            ],
            "review_attestation": {
                "marker": "exact-head-review-attestation:v1",
                "verdict": "no_findings",
                "authority_model": "owner_accountable_assertion",
                "cryptographic_agent_execution_proof": false,
                "malicious_repository_owner_in_scope": false,
                "requires_unedited_comment": true,
                "activity_watermarks": ["review_id", "review_comment_id"],
                "trusted_author_associations": ["OWNER"],
                "blocking_feedback_author_associations": ["OWNER", "MEMBER", "COLLABORATOR"]
            }
        }
    },
    "review": {
        "sensitive_changes_require_independent_final_reviews": true,
        "sensitive_change_lenses": ["correctness_security", "design_maintainability", "tests_regression_flake"]
    },
    "public_write": {
        "caller_supplied_values_create_authority": false,
        "requires_authority_bound_to_target": true,
        "requires_null_mutation_on_rejection": true,
        "requires_race_validation_before_mutation": true
    },
    "evidence_privacy": {
        "allow_secrets": false,
        "allow_capability_values": false,
        "allow_personal_data": false
    },
    "surfaces": {
        "WORKFLOW.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {
                "### 3. Validate locally": [
                    "blocking GitHub CI plus final reviews on the unchanged exact PR head establish"
                ],
                "### 5. Rework loop": ["Every push after review or CI evidence was collected invalidates that landing"],
                "## PR and Review Expectations": [
                    "changes require a third independent lens:",
                    "Final reviews and blocking CI must all target the current unchanged exact PR",
                    "An exit `0` is required before `Ready to Merge`"
                ]
            }
        },
        "code_review.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {
                "## Review Process": [
                    "require three independent final reviews on the same unchanged exact head",
                    "Any later push invalidates those final reviews and requires exact-head review",
                    "The read-only exact-head mergegate does not replace reviewer judgment."
                ]
            }
        },
        "docs/agent-harness-index.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {}
        },
        "docs/exact-head-mergegate.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {
                "## Evidence Contract": ["The command uses authenticated GitHub GET requests and binds all evidence"],
                "## Review Attestation": ["The three final reviews remain independent review work."],
                "## Result and Landing": ["Only an exit 0 after the final PR-head and review-evidence revalidations"]
            }
        },
        "docs/ci-write-contracts.md": {
            "contract_reference": "../.codex/contracts/agent-workflow.json",
            "required_sections": {}
        },
        ".codex/skills/push/SKILL.md": {
            "contract_reference": "../../contracts/agent-workflow.json",
            "required_sections": {}
        },
        ".codex/skills/land/SKILL.md": {
            "contract_reference": "../../contracts/agent-workflow.json",
            "required_sections": {}
        },
        ".github/pull_request_template.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {
                "## Reviewer A (Bugs/Regression/Security/Edge Cases)": [
                    "- [ ] Keine offensichtliche Security-Regression"
                ],
                "## Reviewer B (Architektur/Lesbarkeit/Wartbarkeit)": ["- [ ] Architekturgrenzen und Struktur passen"],
                "## Reviewer C (Tests/Regression/Flake-Risiko)": [
                    "- [ ] Nullmutation und Side-Effect-Grenzen bei Ablehnung geprueft"
                ],
                "## Merge Readiness": [
                    "- [ ] Blocking CI ist gruen",
                    "- [ ] Keine offenen Review-Findings",
                    "- [ ] PR-Head, CI-Head und final reviewter Head sind identisch",
                    "- [ ] PR ist mergeable",
                    "- [ ] Read-only Exact-Head-Mergegate ist fuer diesen unveraenderten Head gruen"
                ]
            }
        }
    },
    "ci": {
        "workflow": ".github/workflows/ci.yml",
        "blocking_failure_control_policy": "strict-v1",
        "job_classification_policy": "explicit-v1",
        "advisory_jobs": ["heavy-job-duration-trends", "pdf-renderer-latency"],
        "blocking_execution_fingerprints": {
            "workflow_execution_envelope": "b00690b770e9cc3b3223dec8bbeb2f46db76443642fb7ddadf3fb8237ebb7f99",
            "changes": "c8cf92dad576b88662c08d394a763d56e595e58aa87de2b021cec8d8ef424a65",
            "build-test": "45788327f8b649ea5fce541761d7b4cf013dde2a9c50bb8169d50f03ce2fa5b2",
            "phpstan-application": "4234ce0b646e5de64081c41446abf75432faec8ec30639f7a1c7271c1ae86db7",
            "js-lint-changed": "2be15a8595f42a9b076782789b1fe5c1386bd19e1abc4b59b936762950436305",
            "architecture-ownership-map": "7311eb7f2a7972b4eaebb9d1a69903517789f8c4ced4ee93483a283c99080cbc",
            "architecture-boundaries": "00625dfc8a980b19c6347413721c10cb57abd73d80f2e4ce5cccf80e8e05333f",
            "typed-request-dto": "79ff1f34a75be0f5dc86fc8fd4a31747eacf93b74aa6a53d1ac791d0afe754c2",
            "typed-request-contracts": "3f24dd994f4a7065af3882077f3916f214b18abd2ad35cf501a5a648c82b2966",
            "deep-check-bootstrap": "28092b98e7676f35338cde15c7781c92b782fa8941fcc74559a28eff3b63f21f",
            "deep-check-seed-snapshot": "90664b0f6efa617ada3e6071c8db2cdbc2409cb8a333450df9a34a692fdf1daa",
            "deep-runtime-suite": "18fdb6d1f9861a456e69bf27f0c7bcd205ee255d6c83bb341d4eef97b74b30a8",
            "coverage-shard-unit": "86c089bdc0a9c907c8ababc2d48515db82f619f44a59951eb1ba6283c2fe060c",
            "coverage-shard-integration": "346e0d427863aa88762d2f070582f8b1eae235f593332aa2981f39eafba1d208",
            "api-contract-openapi": "6e224d3eec1b26fa2eb1e4c3d62f45524253a5e5468cff7e029f9d8b4e2ce069",
            "booking-controller-flows": "cc7be7cb392f2e57805c331b68019a719996bc4fcc32f744ac6461b0e64b3b69",
            "coverage-delta": "16fe2e04d53fe11b5c1e0c2f6d8724582dc1d891cb229d67343f04d9c9310915",
            "integration-smoke": "17de4f0907f27bed9f71f40547041109e8877d8f9ba2643821372dd2cf56b88a"
        },
        "condition_grammar": {
            "version": 1,
            "operators": {
                "and": "&&",
                "or": "||",
                "equals": "=="
            },
            "grouping": {
                "open": "(",
                "close": ")"
            },
            "identifier_pattern": "[A-Za-z_][A-Za-z0-9_.-]*",
            "literals": {
                "string_delimiter": "'",
                "booleans": {
                    "true": true,
                    "false": false
                }
            },
            "zero_argument_calls": ["always", "failure"],
            "unsupported_syntax_fails_closed": true
        },
        "blocking_jobs": {
            "changes": {
                "kind": "fingerprinted_execution"
            },
            "build-test": {
                "kind": "fingerprinted_execution"
            },
            "phpstan-application": {
                "kind": "fingerprinted_execution"
            },
            "js-lint-changed": {
                "kind": "fingerprinted_execution"
            },
            "architecture-ownership-map": {
                "kind": "fingerprinted_execution"
            },
            "architecture-boundaries": {
                "kind": "fingerprinted_execution"
            },
            "typed-request-dto": {
                "kind": "fingerprinted_execution"
            },
            "typed-request-contracts": {
                "kind": "fingerprinted_execution"
            },
            "deep-check-bootstrap": {
                "kind": "fingerprinted_execution"
            },
            "deep-check-seed-snapshot": {
                "kind": "fingerprinted_execution"
            },
            "deep-runtime-suite": {
                "kind": "fingerprinted_execution"
            },
            "coverage-shard-unit": {
                "kind": "fingerprinted_execution"
            },
            "coverage-shard-integration": {
                "kind": "fingerprinted_execution"
            },
            "api-contract-openapi": {
                "kind": "fingerprinted_execution"
            },
            "booking-controller-flows": {
                "kind": "fingerprinted_execution"
            },
            "coverage-delta": {
                "kind": "fingerprinted_execution"
            },
            "write-contract-booking": {
                "kind": "exact_execution",
                "needs": ["changes", "deep-runtime-suite"],
                "runs_on": "ubuntu-latest",
                "timeout_minutes": 35,
                "condition": {
                    "all": [
                        {"call": "always"},
                        {
                            "equals": ["needs.changes.outputs.write_contract_booking", "true"]
                        },
                        {
                            "any": [
                                {
                                    "equals": ["github.event_name", "push"]
                                },
                                {
                                    "all": [
                                        {
                                            "equals": ["github.event_name", "pull_request"]
                                        },
                                        {
                                            "equals": ["github.event.pull_request.draft", false]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "evidence": {
                    "checkout_action": "actions/checkout@v6",
                    "download_action": "actions/download-artifact@v8",
                    "artifact": "deep-runtime-suite-artifacts",
                    "path": "storage/logs/ci/deep-runtime-suite"
                },
                "assertion": {
                    "run": "php scripts/ci/assert_deep_runtime_suite.php --manifest=storage/logs/ci/deep-runtime-suite/manifest.json --suite=write-contract-booking"
                },
                "post_assertion_steps": [
                    {
                        "if": "failure()",
                        "run": "cat storage/logs/ci/deep-runtime-suite/manifest.json || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-booking.log || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-booking.json || true\n"
                    }
                ]
            },
            "write-contract-api": {
                "kind": "exact_execution",
                "needs": ["changes", "deep-runtime-suite"],
                "runs_on": "ubuntu-latest",
                "timeout_minutes": 35,
                "condition": {
                    "all": [
                        {"call": "always"},
                        {
                            "equals": ["needs.changes.outputs.write_contract_api", "true"]
                        },
                        {
                            "any": [
                                {
                                    "equals": ["github.event_name", "push"]
                                },
                                {
                                    "all": [
                                        {
                                            "equals": ["github.event_name", "pull_request"]
                                        },
                                        {
                                            "equals": ["github.event.pull_request.draft", false]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "evidence": {
                    "checkout_action": "actions/checkout@v6",
                    "download_action": "actions/download-artifact@v8",
                    "artifact": "deep-runtime-suite-artifacts",
                    "path": "storage/logs/ci/deep-runtime-suite"
                },
                "assertion": {
                    "run": "php scripts/ci/assert_deep_runtime_suite.php --manifest=storage/logs/ci/deep-runtime-suite/manifest.json --suite=write-contract-api"
                },
                "post_assertion_steps": [
                    {
                        "if": "failure()",
                        "run": "cat storage/logs/ci/deep-runtime-suite/manifest.json || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-api.log || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-api.json || true\n"
                    }
                ]
            },
            "integration-smoke": {
                "kind": "fingerprinted_execution"
            }
        }
    }
}

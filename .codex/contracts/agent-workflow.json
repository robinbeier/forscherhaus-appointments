        "condition_grammar": {
            "version": 1,
            "operators": {
                "and": "&&",
                "or": "||",
                "equals": "=="
            },
            "grouping": {
                "open": "(",
                "close": ")"
            },
            "identifier_pattern": "[A-Za-z_][A-Za-z0-9_.-]*",
            "literals": {
                "string_delimiter": "'",
                "booleans": {
                    "true": true,
                    "false": false
                }
            },
            "zero_argument_calls": ["always", "failure"],
            "unsupported_syntax_fails_closed": true

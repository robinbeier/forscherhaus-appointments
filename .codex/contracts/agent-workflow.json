{
    "schema_version": 2,
    "publish": {
        "linear_state": "In Review",
        "may_set_ready_to_merge": false,
        "push_invalidates_exact_head_evidence": true
    },
    "authority": {
        "primary_external_single_writer": true,
        "primary_owned_mutations": [
            "commit",
            "push",
            "pr_mutation",
            "check_rerun",
            "merge",
            "linear_mutation",
            "workpad_update"
        ]
    },
    "land": {
        "requires_exact_head": true,
        "requires_base_check_before_merge": true,
        "base_change_requires_new_head_and_current_blocking_ci": true,
        "head_cas_does_not_guard_base": true,
        "merge_command": "gh pr merge --merge --match-head-commit <current_head_sha>",
        "push_after_ready_linear_state": "In Review",
        "requires_independent_review": true,
        "requires_current_blocking_ci": true
    },
    "review": {
        "mode": "standard",
        "minimum_independent_reviewers": 1,
        "specialist_review": "risk_based",
        "execution": "independent_reviewer_read_only_preferred_or_human",
        "requires_sealed_runner": false,
        "requires_external_bootstrap_review": false,
        "summary_binds_reviewed_head": true,
        "summary_binds_reviewed_base": true,
        "runtime_preflight": {
            "protocol": "docs/reviewer-runtime-preflight.md",
            "capability_source": "current_runtime",
            "before_diff_dispatch": true,
            "startup_probe_is_review": false,
            "read_only_preferred": true,
            "requires_enforced_read_only_boundary": false,
            "fallback_preserves": [
                "independence",
                "correctness_security",
                "design_maintainability",
                "tests_regressions",
                "repository_base_head",
                "approved_model_and_data_scope",
                "auditable_tool_calls",
                "no_credentials_or_production_data",
                "no_reviewer_mutation_or_external_action"
            ],
            "write_capable_reviewer_requires_auditable_tool_log": true,
            "write_capable_reviewer_requires_postcheck": true,
            "write_capable_reviewer_residual_risk_recorded": true,
            "runtime_failure_classification": "harness_failure",
            "no_equivalent_reviewer": "block_merge",
            "requires_fresh_probe_context": true,
            "startup_probe_input": "self_contained_readiness_request_only"
        }
    },
    "public_write": {
        "caller_supplied_values_create_authority": false,
        "requires_authority_bound_to_target": true,
        "requires_null_mutation_on_rejection": true,
        "requires_race_validation_before_mutation": true
    },
    "evidence_privacy": {
        "allow_secrets": false,
        "allow_capability_values": false,
        "allow_personal_data": false
    },
    "ci": {
        "workflow": ".github/workflows/ci.yml",
        "blocking_failure_control_policy": "strict-v2",
        "job_classification_policy": "explicit-v1",
        "advisory_jobs": [],
        "blocking_execution_fingerprints": {

{
    "schema_version": 2,
    "publish": {
        "linear_state": "In Review",
        "may_set_ready_to_merge": false,
        "push_invalidates_exact_head_evidence": true
    },
    "authority": {
        "primary_external_single_writer": true,
        "primary_owned_mutations": [
            "commit",
            "push",
            "pr_mutation",
            "check_rerun",
            "merge",
            "linear_mutation",
            "workpad_update"
        ]
    },
    "land": {
        "requires_exact_head": true,
        "merge_command": "gh pr merge --merge --match-head-commit <current_head_sha>",
        "push_after_ready_linear_state": "In Review",
        "requires_independent_review": true,
        "requires_current_blocking_ci": true
    },
    "review": {
        "mode": "standard",
        "minimum_independent_reviewers": 1,
        "specialist_review": "risk_based",
        "execution": "available_read_only_reviewer_or_human",
        "requires_sealed_runner": false,
        "requires_external_bootstrap_review": false,
        "summary_binds_reviewed_head": true
    },
    "public_write": {
        "caller_supplied_values_create_authority": false,
        "requires_authority_bound_to_target": true,
        "requires_null_mutation_on_rejection": true,
        "requires_race_validation_before_mutation": true
    },
    "evidence_privacy": {
        "allow_secrets": false,
        "allow_capability_values": false,
        "allow_personal_data": false
    },
    "ci": {
        "workflow": ".github/workflows/ci.yml",
        "blocking_failure_control_policy": "strict-v1",
        "job_classification_policy": "explicit-v1",
        "advisory_jobs": [],
        "blocking_execution_fingerprints": {
            "workflow_execution_envelope": "b00690b770e9cc3b3223dec8bbeb2f46db76443642fb7ddadf3fb8237ebb7f99",
            "api-contract-openapi": "6e224d3eec1b26fa2eb1e4c3d62f45524253a5e5468cff7e029f9d8b4e2ce069",
            "architecture-boundaries": "c655384ce6979371fa42b087cdffdb8c9d9bff75d287972570e3c17c8d817d84",
            "architecture-ownership-map": "7311eb7f2a7972b4eaebb9d1a69903517789f8c4ced4ee93483a283c99080cbc",
            "booking-controller-flows": "cc7be7cb392f2e57805c331b68019a719996bc4fcc32f744ac6461b0e64b3b69",
            "build-test": "3b70e4ce8581167df367434c1d8f1b3c09a893d51433ca1ec1e08555989f22b4",
            "changes": "22a2ff5798e086fa9ab38576902c71c51dd3d318a7a59b97382f9d9a50e86907",
            "coverage-delta": "5ceefd757a18f9bc5e3d6bea19fb6ca32bb2a83ebb77a781bfe077dada7a05ba",
            "coverage-shard-integration": "7c9af9305dad6bd9725f4dcaa5b4a8254717be256d4ac3c80a07d75dcfd37ae6",
            "coverage-shard-unit": "c73abb5eeb1dc51a65c198b07f40567ea2adcc4042ffa9496baad3b83a433af9",
            "deep-runtime-suite": "8eb3720a7a31f3ef91c46f13d9f27be12b088b1195abcaeed83f4d28762f9d2f",
            "integration-smoke": "17de4f0907f27bed9f71f40547041109e8877d8f9ba2643821372dd2cf56b88a",
            "js-lint-changed": "b985e98379a12a16dcb3cd400d7b1031ab77d1a6ea26be68c9603f22315b6e58",
            "pdf-renderer-tests": "f1eaead4ec5726c94d67dab088268f7394e9c1d902f60feffa5783184ae4646c",
            "phpstan-application": "9f59a61df75b5df5904661560490a70a1c9269dcec320757ed11d6f5dc566bf7",
            "root-deployment-tests": "b53b993a9b9ee718d37d00598e9253665fa93538872333a3e55fc7eae6972a56",
            "typed-request-contracts": "50b13f9339970e4c886503707fa8320ff5dc556694b3df524625cc912b9c44e7",
            "typed-request-dto": "5e2a6daa0ed2b9bed4fbfbbab065e20b7ed25abe157a1265e84297c2219b2b00"
        },
        "condition_grammar": {
            "version": 1,
            "operators": {
                "and": "&&",
                "or": "||",
                "equals": "=="
            },
            "grouping": {
                "open": "(",
                "close": ")"
            },
            "identifier_pattern": "[A-Za-z_][A-Za-z0-9_.-]*",
            "literals": {
                "string_delimiter": "'",
                "booleans": {
                    "true": true,
                    "false": false
                }
            },
            "zero_argument_calls": ["always", "failure"],
            "unsupported_syntax_fails_closed": true
        },
        "blocking_jobs": {
            "changes": {
                "kind": "fingerprinted_execution"
            },
            "build-test": {
                "kind": "fingerprinted_execution"
            },
            "phpstan-application": {
                "kind": "fingerprinted_execution"
            },
            "js-lint-changed": {
                "kind": "fingerprinted_execution"
            },
            "architecture-ownership-map": {
                "kind": "fingerprinted_execution"
            },
            "architecture-boundaries": {
                "kind": "fingerprinted_execution"
            },
            "typed-request-dto": {
                "kind": "fingerprinted_execution"
            },
            "typed-request-contracts": {
                "kind": "fingerprinted_execution"
            },
            "deep-runtime-suite": {
                "kind": "fingerprinted_execution"
            },
            "coverage-shard-unit": {
                "kind": "fingerprinted_execution"
            },
            "coverage-shard-integration": {
                "kind": "fingerprinted_execution"
            },
            "api-contract-openapi": {
                "kind": "fingerprinted_execution"
            },
            "booking-controller-flows": {
                "kind": "fingerprinted_execution"
            },
            "coverage-delta": {
                "kind": "fingerprinted_execution"
            },
            "write-contract-booking": {
                "kind": "exact_execution",
                "needs": ["changes", "deep-runtime-suite"],
                "runs_on": "ubuntu-latest",
                "timeout_minutes": 35,
                "condition": {
                    "all": [
                        {
                            "call": "always"
                        },
                        {
                            "equals": ["needs.changes.outputs.write_contract_booking", "true"]
                        },
                        {
                            "any": [
                                {
                                    "equals": ["github.event_name", "push"]
                                },
                                {
                                    "all": [
                                        {
                                            "equals": ["github.event_name", "pull_request"]
                                        },
                                        {
                                            "equals": ["github.event.pull_request.draft", false]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "evidence": {
                    "checkout_action": "actions/checkout@v6",
                    "download_action": "actions/download-artifact@v8",
                    "artifact": "deep-runtime-suite-artifacts",
                    "path": "storage/logs/ci/deep-runtime-suite"
                },
                "assertion": {
                    "run": "php scripts/ci/assert_deep_runtime_suite.php --manifest=storage/logs/ci/deep-runtime-suite/manifest.json --suite=write-contract-booking"
                },
                "post_assertion_steps": [
                    {
                        "if": "failure()",
                        "run": "cat storage/logs/ci/deep-runtime-suite/manifest.json || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-booking.log || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-booking.json || true\n"
                    }
                ]
            },
            "write-contract-api": {
                "kind": "exact_execution",
                "needs": ["changes", "deep-runtime-suite"],
                "runs_on": "ubuntu-latest",
                "timeout_minutes": 35,
                "condition": {
                    "all": [
                        {
                            "call": "always"
                        },
                        {
                            "equals": ["needs.changes.outputs.write_contract_api", "true"]
                        },
                        {
                            "any": [
                                {
                                    "equals": ["github.event_name", "push"]
                                },
                                {
                                    "all": [
                                        {
                                            "equals": ["github.event_name", "pull_request"]
                                        },
                                        {
                                            "equals": ["github.event.pull_request.draft", false]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "evidence": {
                    "checkout_action": "actions/checkout@v6",
                    "download_action": "actions/download-artifact@v8",
                    "artifact": "deep-runtime-suite-artifacts",
                    "path": "storage/logs/ci/deep-runtime-suite"
                },
                "assertion": {
                    "run": "php scripts/ci/assert_deep_runtime_suite.php --manifest=storage/logs/ci/deep-runtime-suite/manifest.json --suite=write-contract-api"
                },
                "post_assertion_steps": [
                    {
                        "if": "failure()",
                        "run": "cat storage/logs/ci/deep-runtime-suite/manifest.json || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-api.log || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-api.json || true\n"
                    }
                ]
            },
            "integration-smoke": {
                "kind": "fingerprinted_execution"
            },
            "pdf-renderer-tests": {
                "kind": "fingerprinted_execution"
            },
            "root-deployment-tests": {
                "kind": "fingerprinted_execution"
            }
        }
    }
}

{
    "schema_version": 2,
    "publish": {
        "linear_state": "In Review",
        "may_set_ready_to_merge": false,
        "push_invalidates_exact_head_evidence": true
    },
    "land": {
        "requires_exact_head": true,
        "merge_command": "gh pr merge --merge --match-head-commit <current_head_sha>",
        "push_after_ready_linear_state": "In Review"
    },
    "review": {
        "sensitive_changes_require_independent_final_reviews": true,
        "sensitive_change_lenses": ["correctness_security", "design_maintainability", "tests_regression_flake"]
    },
    "public_write": {
        "caller_supplied_values_create_authority": false,
        "requires_authority_bound_to_target": true,
        "requires_null_mutation_on_rejection": true,
        "requires_race_validation_before_mutation": true
    },
    "evidence_privacy": {
        "allow_secrets": false,
        "allow_capability_values": false,
        "allow_personal_data": false
    },
    "surfaces": {
        "WORKFLOW.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {
                "### 3. Validate locally": [
                    "blocking GitHub CI plus final reviews on the unchanged exact PR head establish"
                ],
                "### 5. Rework loop": ["Every push after review or CI evidence was collected invalidates that landing"],
                "## PR and Review Expectations": [
                    "changes require a third independent lens:",
                    "Final reviews and blocking CI must all target the current unchanged exact PR"
                ]
            }
        },
        "code_review.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {
                "## Review Process": [
                    "require three independent final reviews on the same unchanged exact head",
                    "Any later push invalidates those final reviews and requires exact-head review"
                ]
            }
        },
        "docs/agent-harness-index.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {}
        },
        "docs/ci-write-contracts.md": {
            "contract_reference": "../.codex/contracts/agent-workflow.json",
            "required_sections": {}
        },
        ".codex/skills/push/SKILL.md": {
            "contract_reference": "../../contracts/agent-workflow.json",
            "required_sections": {}
        },
        ".codex/skills/land/SKILL.md": {
            "contract_reference": "../../contracts/agent-workflow.json",
            "required_sections": {}
        },
        ".github/pull_request_template.md": {
            "contract_reference": ".codex/contracts/agent-workflow.json",
            "required_sections": {
                "## Reviewer A (Bugs/Regression/Security/Edge Cases)": [
                    "- [ ] Keine offensichtliche Security-Regression"
                ],
                "## Reviewer B (Architektur/Lesbarkeit/Wartbarkeit)": ["- [ ] Architekturgrenzen und Struktur passen"],
                "## Reviewer C (Tests/Regression/Flake-Risiko)": [
                    "- [ ] Nullmutation und Side-Effect-Grenzen bei Ablehnung geprueft"
                ],
                "## Merge Readiness": [
                    "- [ ] Blocking CI ist gruen",
                    "- [ ] Keine offenen Review-Findings",
                    "- [ ] PR-Head, CI-Head und final reviewter Head sind identisch",
                    "- [ ] PR ist mergeable"
                ]
            }
        }
    },
    "ci": {
        "workflow": ".github/workflows/ci.yml",
        "blocking_failure_controls": {
            "forbidden_job_keys": ["continue-on-error"],
            "forbidden_job_run_default_keys": ["shell"],
            "forbidden_step_keys": ["continue-on-error", "shell"]
        },
        "condition_grammar": {
            "version": 1,
            "operators": {
                "and": "&&",
                "or": "||",
                "equals": "=="
            },
            "grouping": {
                "open": "(",
                "close": ")"
            },
            "identifier_pattern": "[A-Za-z_][A-Za-z0-9_.-]*",
            "literals": {
                "string_delimiter": "'",
                "booleans": {
                    "true": true,
                    "false": false
                }
            },
            "zero_argument_calls": ["always"],
            "unsupported_syntax_fails_closed": true
        },
        "job_inventory_is_exhaustive": true,
        "advisory_jobs": {
            "heavy-job-duration-trends": {
                "kind": "advisory_signal"
            },
            "pdf-renderer-latency": {
                "kind": "advisory_signal"
            }
        },
        "blocking_jobs": {
            "changes": {
                "kind": "presence_only"
            },
            "build-test": {
                "kind": "presence_only"
            },
            "phpstan-application": {
                "kind": "presence_only"
            },
            "js-lint-changed": {
                "kind": "presence_only"
            },
            "architecture-ownership-map": {
                "kind": "presence_only"
            },
            "architecture-boundaries": {
                "kind": "presence_only"
            },
            "typed-request-dto": {
                "kind": "presence_only"
            },
            "typed-request-contracts": {
                "kind": "presence_only"
            },
            "deep-check-bootstrap": {
                "kind": "presence_only"
            },
            "deep-check-seed-snapshot": {
                "kind": "presence_only"
            },
            "deep-runtime-suite": {
                "kind": "presence_only"
            },
            "coverage-shard-unit": {
                "kind": "presence_only"
            },
            "coverage-shard-integration": {
                "kind": "presence_only"
            },
            "api-contract-openapi": {
                "kind": "presence_only"
            },
            "booking-controller-flows": {
                "kind": "presence_only"
            },
            "coverage-delta": {
                "kind": "presence_only"
            },
            "write-contract-booking": {
                "kind": "exact_execution",
                "needs": ["changes", "deep-runtime-suite"],
                "condition": {
                    "all": [
                        {"call": "always"},
                        {
                            "equals": ["needs.changes.outputs.write_contract_booking", "true"]
                        },
                        {
                            "any": [
                                {
                                    "equals": ["github.event_name", "push"]
                                },
                                {
                                    "all": [
                                        {
                                            "equals": ["github.event_name", "pull_request"]
                                        },
                                        {
                                            "equals": ["github.event.pull_request.draft", false]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "evidence": {
                    "checkout_action": "actions/checkout@v6",
                    "download_action": "actions/download-artifact@v8",
                    "artifact": "deep-runtime-suite-artifacts",
                    "path": "storage/logs/ci/deep-runtime-suite"
                },
                "assertion": {
                    "run": "php scripts/ci/assert_deep_runtime_suite.php --manifest=storage/logs/ci/deep-runtime-suite/manifest.json --suite=write-contract-booking"
                },
                "post_assertion_steps": [
                    {
                        "if": "failure()",
                        "run": "cat storage/logs/ci/deep-runtime-suite/manifest.json || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-booking.log || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-booking.json || true\n"
                    }
                ]
            },
            "write-contract-api": {
                "kind": "exact_execution",
                "needs": ["changes", "deep-runtime-suite"],
                "condition": {
                    "all": [
                        {"call": "always"},
                        {
                            "equals": ["needs.changes.outputs.write_contract_api", "true"]
                        },
                        {
                            "any": [
                                {
                                    "equals": ["github.event_name", "push"]
                                },
                                {
                                    "all": [
                                        {
                                            "equals": ["github.event_name", "pull_request"]
                                        },
                                        {
                                            "equals": ["github.event.pull_request.draft", false]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "evidence": {
                    "checkout_action": "actions/checkout@v6",
                    "download_action": "actions/download-artifact@v8",
                    "artifact": "deep-runtime-suite-artifacts",
                    "path": "storage/logs/ci/deep-runtime-suite"
                },
                "assertion": {
                    "run": "php scripts/ci/assert_deep_runtime_suite.php --manifest=storage/logs/ci/deep-runtime-suite/manifest.json --suite=write-contract-api"
                },
                "post_assertion_steps": [
                    {
                        "if": "failure()",
                        "run": "cat storage/logs/ci/deep-runtime-suite/manifest.json || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-api.log || true\ncat storage/logs/ci/deep-runtime-suite/write-contract-api.json || true\n"
                    }
                ]
            },
            "integration-smoke": {
                "kind": "presence_only"
            }
        }
    }
}

[Unit]
Description=Forscherhaus conservative release archive and dump retention
Documentation=file:/var/www/html/easyappointments/docs/ops/production-release-archive-dump-retention.md
After=local-fs.target
ConditionPathIsDirectory=/var/www/html/easyappointments
ConditionPathIsDirectory=/root/releases
ConditionPathIsDirectory=/root/backups/easyappointments

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/fh-release-archive-dump-retention-v1 execute
StateDirectory=fh-release-retention
StateDirectoryMode=0700
Nice=15
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=5
IOWeight=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/usr/local/libexec/fh-release-archive-dump-retention-v1
ReadOnlyPaths=/var/lib/fh-deploy-evidence /var/lib/fh-deploy-orchestrator
ReadWritePaths=/var/www/html /root/releases /root/backups/easyappointments /var/lib/fh-release-retention /var/lib/fh-deploy-orchestrator/locks/fh-production-change.lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=

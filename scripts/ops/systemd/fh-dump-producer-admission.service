[Unit]
Description=Forscherhaus read-only dump producer admission status
Documentation=file:/var/www/html/easyappointments/docs/ops/production-dump-producer-admission.md
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/fh-release-archive-dump-retention-v1 admission-status
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/usr/local/libexec/fh-release-archive-dump-retention-v1 -/root/backups/easyappointments -/var/lib/fh-deploy-evidence -/var/lib/fh-deploy-orchestrator
ReadWritePaths=-/var/lib/fh-deploy-orchestrator/locks/fh-production-change.lock
InaccessiblePaths=/var/run/docker.sock
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=

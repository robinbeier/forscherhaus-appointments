#!/usr/bin/env bash
set -euo pipefail

# managed-by-forscherhaus-precommit
# This automatic hook is deliberately inert: branch-controlled formatters,
# interpreters, package scripts, and containers run only in explicit CI-parity
# pre-PR checks.
if [[ "${SKIP_PRECOMMIT:-0}" == "1" ]]; then
    echo "SKIP_PRECOMMIT=1 detected - skipping hook."
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

if git diff --cached --no-ext-diff --no-textconv --quiet; then
    exit 0
fi

staged_files=()
while IFS= read -r -d '' file; do
    staged_files+=("$file")
done < <(git diff --cached --no-ext-diff --no-textconv --name-only --diff-filter=ACMRD -z)

for file in "${staged_files[@]}"; do
    case "${file}" in
        storage/logs/*)
            echo "ERROR: Files under storage/logs/ must not be committed." >&2
            exit 1
            ;;
    esac
done

if ! git diff --cached --no-ext-diff --no-textconv --check; then
    echo "ERROR: Whitespace errors detected in staged changes." >&2
    exit 1
fi

echo "Pre-commit checks passed. Run scripts/ci/pre_pr_quick.sh or pre_pr_full.sh for syntax, formatting, and runtime validation."
